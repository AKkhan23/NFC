# ---- Runtime ----
NODE_ENV=development
PORT=4000

# ---- Database: pick Local or Atlas Cluster ----
# Active source on boot. You can also switch live anytime:
# Settings → Database (requires settings.manage). Choice persists across restarts.
DB_MODE=cluster
# local | cluster

# Local MongoDB (Docker `mongo` service or `mongod` on this machine).
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/nfc_band_management

# Atlas cluster. Create one at https://cloud.mongodb.com → Connect → Drivers → copy the
# mongodb+srv:// string. IMPORTANT: Atlas → Network Access → add your IP (or 0.0.0.0/0 for dev).
MONGODB_CLUSTER_URI=mongodb+srv://<user>:<password>@<cluster-host>/nfc_band_management?retryWrites=true&w=majority

# Legacy single-URI fallback (still honored). If MONGODB_CLUSTER_URI is empty and this
# looks like mongodb+srv://, it is used as the cluster URI.
MONGODB_URI=mongodb://127.0.0.1:27017/nfc_band_management

# ---- Auth ----
JWT_SECRET=change-me-32-chars-minimum-dev-only
JWT_REFRESH_SECRET=change-me-32-chars-minimum-dev-only-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- URLs / CORS ----
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SOCKET_URL=http://localhost:4000

# ---- NFC ----
NFC_BRIDGE_URL=http://localhost:8787
NFC_READER_MODE=keyboard
# keyboard | pcsc | serial | network | vendor | bridge
NFC_DUP_WINDOW_MS=3000

# ---- Misc ----
LOG_LEVEL=info
BCRYPT_ROUNDS=12
SEED_DEMO=true

# ---- Online top-up (UPI / gateway webhook) ----
UPI_PAYEE_VPA=school@upi
UPI_PAYEE_NAME=AirData
TOPUP_ORDER_TTL_MIN=30
# Shared secret gateways must send as X-Webhook-Secret (empty = accept in dev, set in prod).
TOPUP_WEBHOOK_SECRET=
# Live gateways (empty = local orders settled by staff confirm / generic webhook).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring billing: dashboard plan/price ids per tier (empty = manual billing only).
RAZORPAY_PLAN_BASIC=
RAZORPAY_PLAN_ADVANCED=
RAZORPAY_PLAN_PRO=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_ADVANCED=
STRIPE_PRICE_PRO=
